{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // Storybook's module mocking is addressed by file name, e.g.
    // sb.mock(import('../src/lib/api.ts')), so the extension must be importable.
    "allowImportingTsExtensions": true,

    // vite/client supplies import.meta.env and the CSS side-effect import
    // declarations; node is needed for process.env in vite.config.ts.
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", ".storybook", "vite.config.ts", "vitest.config.ts"]
}
